<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    style="@style/StandardLinearLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:f="http://schemas.android.com/apk/res-auto">

    <!-- Default view -->

    <LinearLayout
        android:id="@+id/defaultHeader"
        style="@style/StandardLinearLayout">

        <!-- Indicators, settings -->

        <RelativeLayout
            android:layout_marginTop="10dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="10dp"
            style="@style/FillingView">

            <TextView
                android:text="@string/app_name"
                android:layout_centerVertical="true"
                style="@style/Emphasized"/>

            <TextView
                android:textSize="14sp"
                android:id="@+id/ecxPrice"
                style="@style/ChipTextGray"
                android:layout_marginRight="12dp"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/btcPrice"/>

            <TextView
                android:textSize="14sp"
                android:id="@+id/btcPrice"
                style="@style/ChipTextGray"
                android:layout_marginRight="6dp"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/settingsButton"/>

            <ImageButton
                android:padding="5dp"
                android:id="@+id/settingsButton"
                android:src="@drawable/settings_24"
                android:onClick="toggleSettingsMode"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?android:selectableItemBackground"
                style="@style/BoundedView"/>

        </RelativeLayout>

        <!-- Settings -->

        <LinearLayout
            android:layout_marginTop="5dp"
            android:id="@+id/settingsContainer"
            style="@style/XMarginFillingView"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/devInfo"
                android:linksClickable="true"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                style="@style/BoundedView"/>

            <org.apmem.tools.layouts.FlowLayout
                android:id="@+id/settingsButtons"
                style="@style/FillingView"
                f:layout_newLine="true"/>

        </LinearLayout>

        <!-- List of cards -->

        <LinearLayout
            style="@style/FillingView"
            android:layout_marginTop="15dp"
            android:id="@+id/chainCardsContainer"
            android:orientation="vertical"/>

        <TextView
            android:gravity="center"
            android:paddingTop="20dp"
            android:paddingStart="15dp"
            android:id="@+id/recentActivity"
            android:layout_marginBottom="@dimen/corner_radius"
            android:textColor="@color/cardZeroText"
            android:text="@string/recent_activity"
            style="@style/BoundedView"/>

    </LinearLayout>
</LinearLayout>